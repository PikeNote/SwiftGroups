fetchEventTags:
SELECT DISTINCT eventTags FROM events WHERE eventTags != '' ORDER BY eventTags;

filterEventsByTags:
SELECT * FROM events 
WHERE end_time > strftime('%Y-%m-%dT%H:%M:%S', 'now', 'utc') 
AND (
    lower(eventName) LIKE lower('%' || :searchQuery || '%')
)
AND (
    :tags = '' OR
    eventTags LIKE '%' || :tags || '%'
)
ORDER BY start_time LIMIT ?, 50;

