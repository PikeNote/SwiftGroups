CREATE TABLE IF NOT EXISTS events (
        eventId INTEGER PRIMARY KEY,
        start_time TEXT NOT NULL,
        end_time TEXT NOT NULL,
        eventName TEXT NOT NULL,
        eventDesc TEXT NOT NULL,
        eventAttendees INTEGER,
        eventUrl TEXT NOT NULL,
        eventLocation TEXT NOT NULL,
        eventPicture TEXT NOT NULL,
        clubURL TEXT NOT NULL,
        eventCategory TEXT NOT NULL,
        clubName TEXT NOT NULL,
        userCacheData TEXT NOT NULL DEFAULT '',
        FOREIGN KEY (clubName)
               REFERENCES clubs (clubName),
        UNIQUE(eventId)
);

CREATE TABLE IF NOT EXISTS clubs (
        clubName TEXT PRIMARY KEY,
        clubID TEXT NOT NULL,
        clubUrl TEXT NOT NULL,
        clubLogo TEXT NOT NULL,
        clubBanner TEXT NOT NULL,
        clubCategories TEXT NOT NULL,
        clubStatus TEXT NOT NULL,
        clubJoinURL TEXT NOT NULL,
        clubCacheData TEXT NOT NULL DEFAULT ''
);

insertEvent {
  UPDATE events
  SET start_time = :start_time,
      end_time = :end_time,
      eventName = :eventName,
      eventDesc = :eventDesc,
      eventAttendees = :eventAttendees,
      eventUrl = :eventUrl,
      eventLocation = :eventLocation,
      eventPicture = :eventPicture,
      clubName = :clubName,
      clubURL = :clubURL,
      eventCategory = :eventCategory
  WHERE eventId = :eventId;

  INSERT OR IGNORE INTO events (eventId,start_time,end_time,eventName,eventDesc,eventAttendees,eventUrl,eventLocation, eventPicture,clubName,clubURL,eventCategory)
  VALUES (:eventId,:start_time,:end_time,:eventName,:eventDesc,:eventAttendees,:eventUrl,:eventLocation, :eventPicture,:clubName,:clubURL,:eventCategory);
}

insertClub {
  UPDATE clubs
  SET clubName = :clubName,
      clubUrl = :clubUrl,
      clubLogo = :clubLogo,
      clubBanner = :clubBanner,
      clubCategories = :clubCategories,
      clubStatus = :clubStatus,
      clubJoinURL = :clubJoinURL
  WHERE clubID = :clubID;

  INSERT OR IGNORE INTO clubs (clubName, clubID, clubUrl, clubLogo, clubBanner, clubCategories, clubStatus, clubJoinURL)
  VALUES (:clubName, :clubID, :clubUrl, :clubLogo, :clubBanner, :clubCategories, :clubStatus, :clubJoinURL);
}

fetchEvent:
SELECT * FROM events WHERE end_time > strftime('%Y-%m-%dT%H:%M:%S', 'now', 'utc') ORDER BY start_time LIMIT ?, 50;

fetchEventClub:
SELECT * FROM events WHERE clubName = ? AND end_time > strftime('%Y-%m-%dT%H:%M:%S', 'now', 'utc') ORDER BY start_time LIMIT 5;

fetchClubCache:
SELECT clubCacheData FROM clubs WHERE clubID = ?;

fetchClubs:
SELECT * FROM clubs WHERE instr(clubName, :filter) > 0 OR :filter=''  ORDER BY clubName LIMIT ?, 50;

fetchSpecificEvent:
SELECT * FROM events WHERE eventId = ?;

updateCache:
UPDATE events SET userCacheData = ? WHERE eventId = ?;

updateClubCache:
UPDATE clubs SET clubCacheData = ? WHERE clubID = ?;

eventsEmpty:
SELECT EXISTS (SELECT 1 FROM events);

clubsEmpty:
SELECT EXISTS (SELECT 1 FROM clubs);